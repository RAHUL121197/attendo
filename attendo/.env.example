# AgentRouter API configuration
# Get a key from https://agentrouter.org
# WARNING: server-side only. Never commit a real key or put it in frontend code.

# Required for the /api/ai/ask endpoint
AGENTROUTER_API_KEY=

# Optional: model to request through AgentRouter (defaults to gpt-5.5)
AGENTROUTER_MODEL=

# Neon/PostgreSQL API configuration
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/attendo?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Set this in the Vite environment to use Neon-backed auth/employees/attendance.
VITE_API_URL=http://localhost:4000