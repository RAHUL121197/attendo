{
  "framework": "vite",
  "installCommand": "npm --prefix attendo install",
  "buildCommand": "npm --prefix attendo run build",
  "outputDirectory": "attendo/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}